{
    "name": "Monsters Of The Void",
    "version": "1.3.0",
    "description": "Monsters Of The Void - A Phaser 3 TypeScript game using template with Parcel 2 as the bundler.",
    "source": "./index.html",
    "browserslist": "> 0.25%, last 2 versions, not dead",
    "scripts": {
        "dev": "node log.js dev &parcel index.html --no-cache --config ./parcel/.parcel.dev --open",
        "build": "parcel build index.html --public-url ./ --config ./parcel/.parcel.prod",
        "dev-nolog": "parcel index.html --no-cache --config ./parcel/.parcel.dev --open",
        "build-nolog": "parcel build index.html --public-url _relativeroute_ --no-source-maps --log-level error --config ./parcel/.parcel.prod",
        "deploy": "gh-pages -d dist"
    },
    "license": "MIT",
    "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
    "devDependencies": {
        "@parcel/transformer-glsl": "2.14.4",
        "@parcel/transformer-typescript-tsc": "2.14.4",
        "@types/crypto-js": "^4.2.2",
        "express": "5.1.0",
        "gh-pages": "^6.3.0",
        "parcel": "2.14.4",
        "parcel-reporter-clean-dist": "^1.0.4",
        "parcel-reporter-static-files-copy": "^1.5.3",
        "process": "^0.11.10",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "crypto-js": "^4.2.0",
        "phaser": "^3.90.0"
    },
    "staticFiles": {
        "staticPath": "public"
    }
}